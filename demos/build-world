#!/bin/sh

guile_prefix=/opt/local

GUILE_LOAD_PATH=`pwd`/..:$GUILE_LOAD_PATH
export GUILE_LOAD_PATH

guild freeze -b -s -X world.scm

# I must do by hand becuase (system xxx) does not inherit environment.
gcc -g -o world \
	`pkg-config --cflags guile-3.0` \
	world.c world.xd/*.o \
	-Xlinker -rpath=$guile_prefix/lib \
	`pkg-config --libs guile-3.0`

# --- last line ---
