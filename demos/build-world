#!/bin/sh

guile_prefix=/opt/guile-rel/3.0.11-fzr

PATH=$guile_prefix/bin:$PATH
CFLAGS=-I$guile_prefix/include/guile/3.0
LIBS="-L$guile_prefix/lib -lguile-3.0 -lgc -lpthread -ldl"
LIBS="-Xlinker --rpath=$guile_prefix/lib $LIBS"

GUILE_LOAD_PATH=`pwd`/..:$GUILE_LOAD_PATH
export GUILE_LOAD_PATH


guild freeze -b -s world.scm

gcc -g -o world $CFLAGS world.c world.xd/*.o $LIBS

# --- last line ---
